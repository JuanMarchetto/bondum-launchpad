# Privy authentication — get your App ID at https://dashboard.privy.io
NEXT_PUBLIC_PRIVY_APP_ID=your-privy-app-id

# Bondum Launchpad API URL
NEXT_PUBLIC_API_URL=http://localhost:3002

# Solana RPC endpoint (devnet for development, mainnet for production)
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
